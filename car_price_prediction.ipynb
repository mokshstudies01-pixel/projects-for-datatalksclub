  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Q2. Median for horsepower"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "254.0"
      ]
     },
     "execution_count": 6,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df.horsepower.median()  # 254.0"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Split + training functions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "metadata": {},
   "outputs": [],
   "source": [
    "def split(df, seed):\n",
    "    n = len(df)\n",
    "    n_val = int(n * 0.2)\n",
    "    n_test = int(n * 0.2)\n",
    "    n_train = n - n_val - n_test\n",
    "\n",
    "    np.random.seed(seed)\n",
    "    idx = np.arange(n)\n",
    "    np.random.shuffle(idx)\n",
    "\n",
    "    df_train = df.iloc[idx[:n_train]]\n",
    "    df_val = df.iloc[idx[n_train:n_train + n_val]]\n",
    "    df_test = df.iloc[idx[n_train + n_val:]]\n",
    "    return df_train, df_val, df_test\n",
    "\n",
    "\n",
    "def train_linear_regression(X, y):\n",
    "    ones = np.ones(X.shape[0])\n",
    "    X = np.column_stack([ones, X])\n",
    "    XTX = X.T.dot(X)\n",
    "    w_full = np.linalg.inv(XTX).dot(X.T).dot(y)\n",
    "    return w_full[0], w_full[1:]\n",
    "\n",
    "\n",
    "def train_linear_regression_reg(X, y, r=0.0):\n",
    "    ones = np.ones(X.shape[0])\n",
    "    X = np.column_stack([ones, X])\n",
    "    XTX = X.T.dot(X) + r * np.eye(X.shape[1])\n",
    "    w_full = np.linalg.inv(XTX).dot(X.T).dot(y)\n",
    "    return w_full[0], w_full[1:]\n",
    "\n",
    "\n",
    "def rmse(y, y_pred):\n",
    "    return np.sqrt(((y - y_pred) ** 2).mean())\n",
    "\n",
    "\n",
    "base = ['engine_displacement', 'horsepower', 'vehicle_weight', 'model_year']\n",
    "\n",
    "def prepare_X(d, fill_value):\n",
    "    return d[base].fillna(fill_value).values"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Q3. Filling NAs: 0 vs mean"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "(2.205, 2.202)"
      ]
     },
     "execution_count": 8,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "df_train, df_val, df_test = split(df, 42)\n",
    "y_train = df_train.fuel_efficiency_mpg.values\n",
    "y_val = df_val.fuel_efficiency_mpg.values\n",
    "\n",
    "# fill with 0\n",
    "w0, w = train_linear_regression(prepare_X(df_train, 0), y_train)\n",
    "rmse_zero = rmse(y_val, prepare_X(df_val, 0).dot(w) + w0)\n",
    "\n",
    "# fill with mean computed on TRAIN only\n",
    "hp_mean = df_train.horsepower.mean()\n",
    "w0, w = train_linear_regression(prepare_X(df_train, hp_mean), y_train)\n",
    "rmse_mean = rmse(y_val, prepare_X(df_val, hp_mean).dot(w) + w0)\n",
    "\n",
    "round(rmse_zero, 3), round(rmse_mean, 3)  # (2.205, 2.202) -> mean is better"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Q4. Best regularization parameter"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "0 2.2053\n",
      "0.01 2.2058\n",
      "0.1 2.2241\n",
      "1 2.3492\n",
      "5 2.4094\n",
      "10 2.4195\n",
      "100 2.4292\n"
     ]
    }
   ],
   "source": [
    "X_train = prepare_X(df_train, 0)\n",
    "X_val = prepare_X(df_val, 0)\n",
    "\n",
    "for r in [0, 0.01, 0.1, 1, 5, 10, 100]:\n",
    "    w0, w = train_linear_regression_reg(X_train, y_train, r=r)\n",
    "    score = rmse(y_val, X_val.dot(w) + w0)\n",
    "    print(r, round(score, 4))\n",
    "\n",
    "# 0     -> 2.2053  <-- best\n",
    "# 0.01  -> 2.2058\n",
    "# 0.1   -> 2.2241\n",
    "# 1     -> 2.3492\n",
    "# 5     -> 2.4094\n",
    "# 10    -> 2.4195\n",
    "# 100   -> 2.4292"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Q5. RMSE standard deviation across seeds"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "metadata": {},
   "outputs": [
