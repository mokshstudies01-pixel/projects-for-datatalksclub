    "    w0, w = train_linear_regression(prepare_X(d_train, 0), d_train.fuel_efficiency_mpg.values)\n",
    "    score = rmse(d_val.fuel_efficiency_mpg.values, prepare_X(d_val, 0).dot(w) + w0)\n",
